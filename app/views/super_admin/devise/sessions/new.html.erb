<!DOCTYPE html>
<html>
  <head>
    <title>Romicars - CRM Multiagente</title>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'superadmin' %>
  </head>
  <body>
    <div class="h-full w-full antialiased">
      <main class="relative flex flex-col bg-woot-25 min-h-screen w-full py-20 sm:px-6 lg:px-8 dark:bg-slate-900 overflow-hidden">
        <!-- Animated orbs — light mode only -->
        <div class="romicars-sa-orbs" aria-hidden="true">
          <div class="romicars-sa-orb romicars-sa-orb-1"></div>
          <div class="romicars-sa-orb romicars-sa-orb-2"></div>
          <div class="romicars-sa-orb romicars-sa-orb-3"></div>
        </div>
        <section class="relative z-10 max-w-5xl mx-auto">
          <img src="/brand-assets/logotipo.png" alt="RomiCars" class="mx-auto max-w-xs w-full h-auto">
          <h2 class="mt-6 text-center text-3xl font-medium text-slate-900 dark:text-woot-50">
            Howdy, admin 👋
          </h2>
        </section>
        <section class="relative z-10 bg-white shadow sm:mx-auto mt-11 sm:w-full sm:max-w-lg dark:bg-slate-800 p-11 sm:shadow-lg sm:rounded-lg mb-8 mt-15">
          <div>
            <%= form_for(resource, as: resource_name, url: '/super_admin/sign_in') do |f| %>
              <% if flash[:error].present? %>
                <div data-alert class="rounded-md bg-red-500 p-4 text-white text-sm mb-5"><%= flash[:error] %></div>
              <% end %>
              <div class="mb-5">
                <label for="email_address" class="flex justify-between text-sm font-medium leading-6 text-slate-900 dark:text-white">
                Email Address
                </label>
                <div class="mt-1">
                  <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Email eg: someone@example.com", class: "block w-full rounded-md border-0 px-3 py-3 appearance-none shadow-sm ring-1 ring-inset text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-woot-500 sm:text-sm sm:leading-6 outline-none dark:bg-slate-700 dark:ring-slate-600 dark:focus:ring-woot-500 ring-slate-200" %>
                </div>
              </div>
              <div class="mb-5">
                <label for="password" class="flex justify-between text-sm font-medium leading-6 text-slate-900 dark:text-white">
                  Password
                </label>
                <div class="mt-1">
                  <%= f.password_field :password, autocomplete: "current-password",  placeholder: "Password", class: "block w-full rounded-md border-0 px-3 py-3 appearance-none shadow-sm ring-1 ring-inset text-slate-900 dark:text-slate-100 placeholder:text-slate-400 focus:ring-2 focus:ring-inset focus:ring-woot-500 sm:text-sm sm:leading-6 outline-none dark:bg-slate-700 dark:ring-slate-600 dark:focus:ring-woot-500 ring-slate-200" %>
                </div>
              </div>
              <button type="submit" class="flex items-center w-full justify-center rounded-md bg-woot-500 dark:bg-woot-400 py-3 px-3 text-base font-medium text-white shadow-sm hover:bg-woot-600 dark:hover:bg-woot-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-woot-500 cursor-pointer">
                <span>Login</span>
              </button>
            <% end %>
          </div>
        </section>
      </main>
    </div>
  </body>
  <style>
    .romicars-sa-orbs {
      position: absolute;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
    }
    .romicars-sa-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(90px);
    }
    .romicars-sa-orb-1 {
      width: 55vw;
      height: 55vw;
      background: rgba(26, 54, 93, 0.12);
      top: -20%;
      left: -15%;
      animation: sa-orb-drift-1 26s ease-in-out infinite alternate;
    }
    .romicars-sa-orb-2 {
      width: 38vw;
      height: 38vw;
      background: rgba(54, 30, 44, 0.09);
      bottom: -18%;
      right: -10%;
      animation: sa-orb-drift-2 32s ease-in-out infinite alternate;
    }
    .romicars-sa-orb-3 {
      width: 28vw;
      height: 28vw;
      background: rgba(26, 54, 93, 0.08);
      top: 40%;
      right: 20%;
      animation: sa-orb-drift-3 22s ease-in-out infinite alternate;
    }
    @keyframes sa-orb-drift-1 {
      0%   { transform: translate(0, 0); }
      100% { transform: translate(12vw, 16vh); }
    }
    @keyframes sa-orb-drift-2 {
      0%   { transform: translate(0, 0); }
      100% { transform: translate(-10vw, -13vh); }
    }
    @keyframes sa-orb-drift-3 {
      0%   { transform: translate(0, 0); }
      50%  { transform: translate(-8vw, 8vh); }
      100% { transform: translate(10vw, -10vh); }
    }
    @media (prefers-reduced-motion: reduce) {
      .romicars-sa-orb { animation: none !important; }
    }
  </style>
</html>
