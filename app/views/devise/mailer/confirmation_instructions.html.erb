<%
  brand_name = global_config['BRAND_NAME'] || 'Chatwoot'
  recipient_name = @resource.name.presence || @resource.email
  account_user = @resource&.account_users&.first
  inviter = account_user&.inviter
  account_name = account_user&.account&.name
  invited_user = inviter.present? && @resource.unconfirmed_email.blank?

  # Kept in step with enterprise/app/views/devise/mailer/confirmation_instructions.html.erb,
  # which is the one that actually renders — enterprise views come first in the view path.
  # This copy is the fallback, and a fallback in another language would be a surprise.
  eyebrow = 'Bienvenido'
  heading = 'Confirma tu correo para empezar'
  intro_text =
    "Te damos la bienvenida a #{brand_name}. Solo falta verificar tu correo para que puedas usar tu cuenta."
  supporting_text = 'Toma un momento.'
  action_text = 'Confirmar mi cuenta'
  action_url = frontend_url('auth/confirmation', confirmation_token: @token)
  info_title = nil
  info_text = nil
  detail_rows = []
  detail_rows << ['Correo nuevo', @resource.unconfirmed_email] if @resource.unconfirmed_email.present?

  if @resource.unconfirmed_email.present?
    eyebrow = 'Cambio de correo'
    heading = 'Confirma tu nuevo correo'
    intro_text = "Recibimos una solicitud para cambiar el correo de tu cuenta de #{brand_name}."
    supporting_text = 'Confirma la nueva dirección para completar el cambio.'
    action_text = 'Confirmar correo'
  elsif @resource.confirmed?
    eyebrow = 'Cuenta lista'
    heading = 'Tu cuenta está lista'
    intro_text = "Tu cuenta de #{brand_name} ya está activa."
    supporting_text = 'Usa el botón de abajo para entrar y seguir donde lo dejaste.'
    action_text = 'Entrar a mi cuenta'
    action_url = frontend_url('auth/sign_in')
    detail_rows = []
  elsif invited_user
    eyebrow = 'Invitación'
    heading = account_name.present? ? "Te invitaron a #{account_name}" : "Te invitaron a probar #{brand_name}"
    intro_text = if account_name.present?
      "#{inviter.name} te invitó al espacio #{account_name} en #{brand_name}."
    else
      "#{inviter.name} te invitó a probar #{brand_name}."
    end
    supporting_text = 'Crea tu cuenta para empezar a trabajar con el equipo.'
    action_text = 'Aceptar invitación'
    action_url = frontend_url(
      'auth/password/edit',
      reset_password_token: @resource.send(:set_reset_password_token)
    )
    detail_rows = [['Te invitó', inviter.name]]
    detail_rows << ['Espacio de trabajo', account_name] if account_name.present?
  end
%>

<%= render partial: 'devise/mailer/confirmation_body', locals: {
  action_text: action_text,
  action_url: action_url,
  detail_rows: detail_rows,
  eyebrow: eyebrow,
  heading: heading,
  info_text: info_text,
  info_title: info_title,
  intro_text: intro_text,
  recipient_name: recipient_name,
  supporting_text: supporting_text
} %>
